# Copy to .env (or run scripts/init-env.sh, which fills random secrets) and replace every placeholder.
# Do not commit .env. Use letters/digits only in secrets (they are embedded in YAML and URLs).

# --- Network --------------------------------------------------------------------------------
# Hostname clients open (must match the certificate SAN and resolve to the host's LAN IP).
DEMO_HOSTNAME=comms-demo.home.arpa
# The Windows host's LAN IPv4 (discover it on the host; never copy an example IP).
LIVEKIT_NODE_IP=REPLACE_WITH_HOST_LAN_IPV4

# --- PostgreSQL -----------------------------------------------------------------------------
POSTGRES_DB=enterprise_comms
POSTGRES_USER=demo_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET

# --- Redis ----------------------------------------------------------------------------------
REDIS_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET

# --- MinIO ----------------------------------------------------------------------------------
MINIO_ROOT_USER=demo_admin
MINIO_ROOT_PASSWORD=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET
S3_BUCKET=recordings
# Least-privilege identity used by Egress to upload recordings (write only).
MINIO_EGRESS_ACCESS_KEY=egress-writer
MINIO_EGRESS_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Least-privilege identity used by the API to stream/delete recordings (read/delete only).
MINIO_API_ACCESS_KEY=api-reader
MINIO_API_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# --- LiveKit --------------------------------------------------------------------------------
# Tested, explicit image tags. Avoid :latest for a rehearsed demo.
LIVEKIT_IMAGE=livekit/livekit-server:v1.13.9
EGRESS_IMAGE=livekit/egress:v1.15.0
LIVEKIT_API_KEY=REPLACE_WITH_A_RANDOM_API_KEY
# At least 32 characters.
LIVEKIT_API_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
LIVEKIT_TOKEN_TTL_SECONDS=600

# --- First admin (created once on first start) ----------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
ADMIN_DISPLAY_NAME=Administrator

# --- Policy ---------------------------------------------------------------------------------
SESSION_TTL_HOURS=12
MAX_PARTICIPANTS_PER_ROOM=10
MAX_CONCURRENT_RECORDINGS=1
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_FAILURES_PER_USER=5
# Per-source-IP limit (0 disables). With Docker Desktop on Windows every LAN client reaches Caddy
# from the same gateway address, so a per-IP limit would be shared by ALL clients and one person could
# lock everybody out. Keep 0 there and rely on the per-user limit; use e.g. 20 only where Caddy sees real client IPs.
RATE_LIMIT_MAX_FAILURES_PER_IP=0
# Escalating lockouts (minutes) for the 1st, 2nd, 3rd+ lockout of the same user. Kept short because anyone who
# knows an email can trigger them; an admin can also unlock an account from its user page.
RATE_LIMIT_LOCKOUT_MINUTES=1,2,5
# Days to keep audit log rows and recording files before the daily purge deletes them (0 = keep forever).
# Agree these periods with your organisation before real use (PDPA).
AUDIT_RETENTION_DAYS=365
RECORDING_RETENTION_DAYS=180
RECORDING_PRESET=H264_720P_30
RECORDING_LAYOUT=speaker
