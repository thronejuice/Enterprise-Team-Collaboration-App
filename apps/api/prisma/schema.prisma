generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  HOST
  MEMBER
}

enum SuspensionReason {
  RESIGNED
  TERMINATED
  LONG_LEAVE
  SECURITY
  OTHER
}

enum SuspensionStatus {
  SCHEDULED // ตั้งล่วงหน้า ยังไม่มีผล
  ACTIVE    // มีผลแล้ว
  CANCELLED // ยกเลิกก่อนมีผล
  LIFTED    // เปิดบัญชีคืนแล้ว
}

enum MeetingStatus {
  ACTIVE
  ENDED
}

enum RecordingStatus {
  REQUESTED
  STARTING
  RECORDING
  STOPPING
  FINALIZING
  COMPLETED
  FAILED
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique // + unique index บน lower(name) ใน SQL
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("departments")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  displayName  String   @map("display_name")
  passwordHash String   @map("password_hash")
  role         UserRole @default(MEMBER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  firstName          String?   @map("first_name")
  lastName           String?   @map("last_name")
  employeeId         String?   @unique @map("employee_id")
  phone              String?
  jobTitle           String?   @map("job_title")
  departmentId       String?   @map("department_id") @db.Uuid
  avatarKey          String?   @map("avatar_key")
  avatarUpdatedAt    DateTime? @map("avatar_updated_at")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at")
  anonymizedAt       DateTime? @map("anonymized_at")

  meetingsCreated Meeting[]            @relation("MeetingCreator")
  meetingsHosted  Meeting[]            @relation("MeetingHost")
  participations  MeetingParticipant[] @relation("ParticipantUser")
  recordings      Recording[]          @relation("RecordingRequester")
  department      Department?          @relation(fields: [departmentId], references: [id])
  suspensions     UserSuspension[]     @relation("SuspendedUser")

  @@index([departmentId])
  @@map("users")
}

/// room_code is unique only among ACTIVE meetings (partial unique index in migration SQL).
model Meeting {
  id          String        @id @default(uuid()) @map("meeting_id") @db.Uuid
  roomCode    String        @map("room_code") @db.Char(4)
  title       String
  /// Who created the room (history only; host rights come from hostId).
  createdById String        @map("created_by") @db.Uuid
  /// Current controller of the room. Starts equal to createdById and changes on offboarding handover.
  hostId      String        @map("host_id") @db.Uuid
  status      MeetingStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at")
  endedAt     DateTime?     @map("ended_at")

  createdBy    User                 @relation("MeetingCreator", fields: [createdById], references: [id])
  host         User                 @relation("MeetingHost", fields: [hostId], references: [id])
  participants MeetingParticipant[]
  recordings   Recording[]

  @@index([roomCode, status])
  @@index([hostId])
  @@map("meetings")
}

model MeetingParticipant {
  meetingId     String    @map("meeting_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  admittedAt    DateTime  @default(now()) @map("admitted_at")
  /// Set when the user's media connection is first seen by LiveKit (webhook).
  firstJoinedAt DateTime? @map("first_joined_at")
  lastJoinedAt  DateTime? @map("last_joined_at")
  revokedAt     DateTime? @map("revoked_at")
  revokedById   String?   @map("revoked_by") @db.Uuid

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation("ParticipantUser", fields: [userId], references: [id])

  @@id([meetingId, userId])
  @@index([userId])
  @@map("meeting_participants")
}

model Recording {
  id            String          @id @default(uuid()) @map("recording_id") @db.Uuid
  meetingId     String          @map("room_id") @db.Uuid
  requestedById String          @map("requested_by") @db.Uuid
  egressJobId   String?         @unique @map("egress_job_id")
  status        RecordingStatus @default(REQUESTED)
  startedAt     DateTime?       @map("started_at")
  endedAt       DateTime?       @map("ended_at")
  objectKey     String          @map("object_key")
  fileSize      BigInt?         @map("file_size")
  durationMs    Int?            @map("duration_ms")
  errorMessage  String?         @map("error_message")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  deletedAt     DateTime?       @map("deleted_at")
  deletedById   String?         @map("deleted_by") @db.Uuid

  meeting     Meeting @relation(fields: [meetingId], references: [id])
  requestedBy User    @relation("RecordingRequester", fields: [requestedById], references: [id])

  @@index([meetingId])
  @@index([status])
  @@map("recordings")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  createdAt  DateTime @default(now()) @map("created_at")
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  ip         String?
  success    Boolean  @default(true)
  metadata   Json?

  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

model UserSuspension {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  reason        SuspensionReason
  note          String?
  status        SuspensionStatus @default(SCHEDULED)
  effectiveAt   DateTime         @map("effective_at")
  handoverToId  String?          @map("handover_to") @db.Uuid
  createdById   String           @map("created_by") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at")
  appliedAt     DateTime?        @map("applied_at")
  cancelledAt   DateTime?        @map("cancelled_at")
  cancelledById String?          @map("cancelled_by") @db.Uuid
  liftedAt      DateTime?        @map("lifted_at")
  liftedById    String?          @map("lifted_by") @db.Uuid
  liftNote      String?          @map("lift_note")

  user User @relation("SuspendedUser", fields: [userId], references: [id])

  @@index([status, effectiveAt])
  @@index([userId])
  @@map("user_suspensions")
}
